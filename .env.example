# Postgres Neon (free tier). Pooler embutido para serverless.
# Hostname inclui o sufixo `-pooler`.
DATABASE_URL=

# URL direta Neon (sem -pooler). Usada pelo Prisma CLI para migrations
# e shadow database. Configurada na Story 1.3.
DIRECT_URL=

# Token de acesso da URL (base64url de 32 bytes random — gerado na Story 1.2; placeholder aqui).
ACCESS_TOKEN=

# Upstash Redis REST (free tier) — store de rate-limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
